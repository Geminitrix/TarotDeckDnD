<Window x:Class="CartomanteApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cartomante - O Tarot" Height="850" Width="1200"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D0914" Offset="0.0"/>
            <GradientStop Color="#1A112C" Offset="0.5"/>
            <GradientStop Color="#050308" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Estilo de Botão Elegante -->
        <Style x:Key="MysticButton" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="#E5D3A3"/>
            <Setter Property="BorderBrush" Value="#8C794C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Book Antiqua"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#D4AF37"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Template: CARTAS NA MÃO (Dinâmicas e ajustáveis) -->
        <DataTemplate x:Key="HandCardTemplate">
            <!-- Viewbox externo: Faz a carta se ajustar à altura da tela -->
            <Viewbox Stretch="Uniform" Margin="10">
                <Border Width="180" Height="280" CornerRadius="8">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D4AF37" Offset="0" />
                            <GradientStop Color="#5C4D24" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>2</Border.BorderThickness>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1F1533" Offset="0"/>
                            <GradientStop Color="#120A1F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="8" Opacity="0.8"/>
                    </Border.Effect>

                    <Grid>
                        <Border BorderBrush="#30D4AF37" BorderThickness="1" Margin="6" CornerRadius="4"/>

                        <!-- Viewbox interno: Garante que o texto fique em 1 linha e nunca quebre -->
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="12,15,12,0" Height="25">
                            <TextBlock Text="{Binding Name}" Foreground="#F0E6D2" FontFamily="Palatino Linotype" FontWeight="Medium" TextWrapping="NoWrap"/>
                        </Viewbox>

                        <!-- Ícone Gigante no Centro -->
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="70" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,30">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#D4AF37" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <Button Content="Invocar" Style="{StaticResource MysticButton}" VerticalAlignment="Bottom" Margin="10,0,10,15" Click="PlayCard_Click" Tag="{Binding}"/>
                    </Grid>
                </Border>
            </Viewbox>
        </DataTemplate>

        <!-- Template: CARTAS DISPONÍVEIS NO NÍVEL (Dinâmicas) -->
        <DataTemplate x:Key="LevelCardTemplate">
            <Viewbox Stretch="Uniform" Margin="8">
                <Border Width="120" Height="180" CornerRadius="6">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#40D4AF37"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Border.Background>
                        <SolidColorBrush Color="#10FFFFFF"/>
                    </Border.Background>
                    <Grid>
                        <!-- Texto em 1 linha -->
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="8,10,8,0" Height="18">
                            <TextBlock Text="{Binding Name}" Foreground="#BDBDBD" FontFamily="Palatino Linotype" TextWrapping="NoWrap"/>
                        </Viewbox>

                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" Margin="0,15,0,0"/>
                    </Grid>
                </Border>
            </Viewbox>
        </DataTemplate>

        <!-- Template: CARTAS NO DESCARTE (Dinâmicas) -->
        <DataTemplate x:Key="DiscardTemplate">
            <Viewbox Stretch="Uniform" Margin="5">
                <Border Width="90" Height="130" CornerRadius="5">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#8B0000" Opacity="0.6"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A0808" Offset="0"/>
                            <GradientStop Color="#120202" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Texto em 1 linha -->
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="5,8,5,0" Height="14">
                            <TextBlock Text="{Binding Name}" Foreground="#A9A9A9" FontFamily="Palatino Linotype" TextWrapping="NoWrap"/>
                        </Viewbox>

                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" Margin="0,15,0,0"/>
                    </Grid>
                </Border>
            </Viewbox>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Topo -->
            <RowDefinition Height="2.5*"/>
            <!-- Mão -->
            <RowDefinition Height="1.8*"/>
            <!-- Cartas do Nível -->
            <RowDefinition Height="1.5*"/>
            <!-- Info e Descarte -->
        </Grid.RowDefinitions>

        <!-- Painel Superior (Controles) -->
        <Border Grid.Row="0" Background="#10FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Nível do Conjurador:" Foreground="#E5D3A3" VerticalAlignment="Center" FontFamily="Book Antiqua" FontSize="18" Margin="0,0,15,0"/>
                <ComboBox x:Name="CboLevel" Width="70" Margin="0,0,30,0" SelectionChanged="CboLevel_SelectionChanged" FontFamily="Book Antiqua" FontSize="16"/>
                <Button Content="Descanso Longo" Style="{StaticResource MysticButton}" Click="LongRest_Click"/>
                <Button Content="Comprar Carta" Style="{StaticResource MysticButton}" Click="DrawCard_Click"/>
            </StackPanel>
        </Border>

        <!-- Área Central (Sua Mão) -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="~ Sua Mão ~" Foreground="#D4AF37" FontFamily="Book Antiqua" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.9"/>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0">
                <ItemsControl x:Name="HandItemsControl" ItemTemplate="{StaticResource HandCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Área das Cartas do Nível (Grimório) -->
        <Border Grid.Row="2" Background="#05FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="0,1" Margin="0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Cartas Disponíveis Neste Nível (O Grimório)" Foreground="#AFAFAF" FontFamily="Book Antiqua" FontSize="18" HorizontalAlignment="Left" Margin="10,0,0,10"/>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0">
                    <ItemsControl x:Name="LevelCardsControl" ItemTemplate="{StaticResource LevelCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Painel Inferior (Descarte e Info) -->
        <Border Grid.Row="3" Background="#0A0510" BorderBrush="#2A1A3F" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Status da Mesa" Foreground="#E5D3A3" FontFamily="Book Antiqua" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtDeckInfo" Text="Cartas no Baralho: 0" Foreground="#BDBDBD" FontFamily="Palatino Linotype" FontSize="16" Margin="0,3"/>
                    <TextBlock x:Name="TxtProficiency" Text="Bônus de Proficiência: +2" Foreground="#BDBDBD" FontFamily="Palatino Linotype" FontSize="16" Margin="0,3"/>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Pilha de Descarte" Foreground="#8B0000" FontFamily="Book Antiqua" FontSize="18" Margin="5,0,0,5"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0">
                        <ItemsControl x:Name="DiscardItemsControl" ItemTemplate="{StaticResource DiscardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>